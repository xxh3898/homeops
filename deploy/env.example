HOMEOPS_DB_NAME=homeops
HOMEOPS_DB_USER=homeops
HOMEOPS_DB_PASSWORD=replace-with-a-secret
HOMEOPS_ALLOWED_USERS=owner@example.invalid
HOMEOPS_AGENT_ID=local-mac
HOMEOPS_INGESTION_SHARED_SECRET=
HOMEOPS_MONITORING_ALLOWED_ORIGINS=
HOMEOPS_WEB_BIND=127.0.0.1:13081
HOMEOPS_AGENT_BIND=127.0.0.1:13443
HOMEOPS_TLS_DIR=/absolute/path/to/homeops/tls
HOMEOPS_API_IMAGE=ghcr.io/example/homeops-api@sha256:1111111111111111111111111111111111111111111111111111111111111111
HOMEOPS_WEB_IMAGE=ghcr.io/example/homeops-web@sha256:2222222222222222222222222222222222222222222222222222222222222222
