<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.homeops.ingestion-reporter</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/REPLACE_ME/Server/apps/homeops/runtime-config/current/scripts/report-homeops-event.py</string>
    <string>--drain</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/REPLACE_ME/Server/apps/homeops</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/HomeOps/ingestion-reporter.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/REPLACE_ME/Library/Logs/HomeOps/ingestion-reporter-error.log</string>
</dict>
</plist>
