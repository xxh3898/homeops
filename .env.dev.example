HOMEOPS_DB_NAME=homeops_dev
HOMEOPS_DB_USER=homeops_dev
HOMEOPS_DB_PASSWORD=replace-with-a-development-only-password
HOMEOPS_ALLOWED_USERS=developer@example.invalid
HOMEOPS_WEB_PORT=127.0.0.1:13080
HOMEOPS_AGENT_PORT=127.0.0.1:13443
HOMEOPS_AGENT_ID=local-mac
HOMEOPS_NOTIFICATIONS_ENABLED=false
HOMEOPS_DISCORD_WEBHOOK_URL=
HOMEOPS_AGENT_API_URL=https://127.0.0.1:13443/api/v1/internal/agent/snapshots
HOMEOPS_AGENT_CLIENT_CERT=./certs/dev-agent.crt
HOMEOPS_AGENT_CLIENT_KEY=./certs/dev-agent.key
HOMEOPS_AGENT_CA_CERT=./certs/dev-ca.crt
HOMEOPS_DOCKER_SOCKET=/var/run/docker.sock
